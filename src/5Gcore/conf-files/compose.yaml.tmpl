services:
  registry:
    image: registry:2
    container_name: ${REGISTRY_NAME:-registry}-${LAB_NAME:-honeypotlab}
    hostname: ${REGISTRY_NAME:-registry}
    restart: unless-stopped
    labels:
      honeypot.role: registry
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        if [ -z "$$REGISTRY_HTTP_TLS_CERTIFICATE" ]; then
          unset REGISTRY_HTTP_TLS_CERTIFICATE REGISTRY_HTTP_TLS_KEY
        fi
        exec /entrypoint.sh /etc/docker/registry/config.yml
    ports:
      - ${COMPOSE_PORT_BIND_ADDR:-127.0.0.1}:${REGISTRY_PORT:-5000}:${REGISTRY_PORT:-5000}
    environment:
      REGISTRY_STORAGE_DELETE_ENABLED: "true"
      REGISTRY_HTTP_ADDR: 0.0.0.0:${REGISTRY_PORT:-5000}
      REGISTRY_AUTH: htpasswd
      REGISTRY_AUTH_HTPASSWD_REALM: Registry Realm
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd
      REGISTRY_HTTP_TLS_CERTIFICATE: ${COMPOSE_REGISTRY_TLS_CERTIFICATE:-}
      REGISTRY_HTTP_TLS_KEY: ${COMPOSE_REGISTRY_TLS_KEY:-}
    volumes:
      - ${COMPOSE_REGISTRY_STORAGE_DIR:-/res/runtime/registry/storage}:/var/lib/registry
      - ${COMPOSE_REGISTRY_AUTH_DIR:-/res/runtime/registry}:/auth:ro
      - ${COMPOSE_REGISTRY_CERTS_DIR:-/res/runtime/registry/certs}:/certs:ro
    networks:
      underlay:
        aliases:
          - ${REGISTRY_NAME:-registry}

  caldera:
    image: ${REGISTRY_CACHE_ENDPOINT:-registry-lab:5000}/caldera:1.0.1
    container_name: ${CALDERA_SERVER:-caldera}-${LAB_NAME:-honeypotlab}
    hostname: ${CALDERA_SERVER:-caldera}
    restart: unless-stopped
    labels:
      honeypot.role: caldera
    environment:
      TZ: Europe/Rome
    volumes:
      - ${COMPOSE_CALDERA_LOCAL_YML}:/usr/src/app/conf/local.yml:ro
      - ${COMPOSE_CALDERA_ABILITIES_DIR}:/usr/src/app/plugins/stockpile/data/abilities/honeypot:ro
      - ${COMPOSE_CALDERA_ADVERSARIES_DIR}:/usr/src/app/plugins/stockpile/data/adversaries/honeypot:ro
    ports:
      - 127.0.0.1:${CALDERA_PORT:-8888}:${CALDERA_PORT:-8888}
    networks:
      underlay:
        aliases:
          - ${CALDERA_SERVER:-caldera}
          - caldera.dock

  attacker:
    image: ${REGISTRY_CACHE_ENDPOINT:-registry-lab:5000}/attacker:1.0.1
    container_name: ${ATTACKER:-attacker}-${LAB_NAME:-honeypotlab}
    hostname: ${ATTACKER:-attacker}
    restart: unless-stopped
    labels:
      honeypot.role: attacker
    privileged: true
    extra_hosts:
      - host.docker.internal:host-gateway
    env_file:
      - ${COMPOSE_ATTACKER_ENV_FILE:-/res/runtime/attacker/attacker.env}
    environment:
      WAIT: "0"
      CALDERA_URL: http://${CALDERA_SERVER:-caldera}:8888
      GROUP: outside
      KC_AGENT_ROLE: entry
      DATA_PATH: /tmp/KCData
      DOCKER_DAEMON: ${ATTACKER_DOCKER_DAEMON:-1}
      REGISTRY_NAME: ${REGISTRY_NAME:-registry}
      REGISTRY_PORT: ${REGISTRY_PORT:-5000}
      ARP_VICTIM: ${LOAD_GENERATOR:-load-generator}
      REGISTRY_USER: ${REGISTRY_USER:-}
      REGISTRY_PASS: ${REGISTRY_PASS:-}
      IMAGE_VERSION: ${IMAGE_VERSION:-2.0.2}
      CONTROL_PLANE_NODE: ${CONTROL_PLANE_NODE:-kind-control-plane}
      CONTROL_PLANE_PORT: ${CONTROL_PLANE_PORT:-6443}
      KUBESERVER_PORT: ${KUBESERVER_PORT:-6443}
      KUBE_APISERVER_IMAGE: ${KUBE_APISERVER_IMAGE:-registry.k8s.io/kube-apiserver:v1.30.0}
      K8S_IMAGE: ${KUBE_APISERVER_IMAGE:-registry.k8s.io/kube-apiserver:v1.30.0}
      PCF_TEST_SERVICE_PORT: ${PCF_TEST_SERVICE_PORT:-2525}
      KC_RCE_PORT: ${PCF_TEST_SERVICE_PORT:-2525}
      FRONTEND_PROXY_IP: ${FRONTEND_PROXY_IP:-172.18.0.200}
      GENERIC_SVC_ADDR: ${GENERIC_SVC_ADDR:-172.18.0.201}
      LOG_NS: ${MEM_NAMESPACE:-mem}
      UPDATER_NAMESPACE: ${IMAGE_UPDATER_NAMESPACE:-kube-system}
      ATTACKED_NS: ${DMZ_NAMESPACE:-dmz}
      AUTH_NS: ${APP_NAMESPACE:-app}
      ATTACKERADDR: ${ATTACKER:-attacker}
      NSPROTO: ${APP_NAMESPACE:-app}
      NSCREDS: ${MEM_NAMESPACE:-mem}
      NSPAYMT: ${PAY_NAMESPACE:-pay}
      NSDATA: ${DAT_NAMESPACE:-dat}
    volumes:
      - ${COMPOSE_ATTACKER_IPHOST_FILE:-/res/runtime/attacker/iphost}:/tmp/iphost:ro
      - ${COMPOSE_ATTACKER_APISERVER_DIR:-/res/runtime/attacker/apiserver}:/apiserver:ro
    networks:
      underlay:
        aliases:
          - ${ATTACKER:-attacker}
          - caldera.outs

  samba:
    image: ${REGISTRY_CACHE_ENDPOINT:-registry-lab:5000}/samba:1.0.1
    container_name: samba-pv-${LAB_NAME:-honeypotlab}
    hostname: samba-pv
    restart: unless-stopped
    labels:
      honeypot.role: samba
    environment:
      TZ: Europe/Rome
      SAMBA_USER: k8s
      SAMBA_PASS: password
      SAMBA_UID: "10001"
      SAMBA_GID: "10001"
      SHARE_NAME: pvroot
      SHARE_PATH: /share
      HOSTS_ALLOW: "127. 172. 192.168."
      ENCRYPTION: required
      LOG_LEVEL: "1"
    cap_add:
      - NET_BIND_SERVICE
      - CHOWN
    tmpfs:
      - /share
    volumes:
      - ${COMPOSE_FREE5GC_CERT_DIR:-../helm-charts/free5gc/cert}:/seed/free5gc-certs:ro
    command:
      - sh
      - -c
      - |
        set -eu
        mkdir -p /share/oauth
        cp /seed/free5gc-certs/nrf.pem /share/oauth/nrf.pem
        cp /seed/free5gc-certs/nrf.key /share/oauth/nrf.key
        chown -R "$${SAMBA_UID}:$${SAMBA_GID}" /share/oauth
        chmod 0750 /share/oauth
        chmod 0444 /share/oauth/nrf.pem /share/oauth/nrf.key
        exec smbd --foreground --no-process-group --configfile=/etc/samba/smb.conf --debug-stdout
    healthcheck:
      test: ["CMD-SHELL", "nc -z 127.0.0.1 445"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 10s
    networks:
      underlay:
        aliases:
          - samba-pv

networks:
  underlay:
    external: true
    name: ${CP_NETWORK:-lab}
