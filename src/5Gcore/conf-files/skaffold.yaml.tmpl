apiVersion: skaffold/v4beta13
kind: Config

metadata:
  name: free5gc-ueransim-kind

build:
  insecureRegistries:
    - ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
    - ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}
  tagPolicy:
    envTemplate:
      template: "{{.IMAGE_VERSION}}"
  local:
    push: true
    useDockerCLI: true
  artifacts:
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/amf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/amf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/ausf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/ausf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/chf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/chf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/dbpython
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/dbpython:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/n3iwf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/n3iwf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/nef
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/nef:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/nrf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/nrf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/nssf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/nssf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/nwdaf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/nwdaf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/controller
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/controller:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/pcf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/pcf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/smf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/smf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/udm
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/udm:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/udr
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/udr:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/upf
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/upf:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/webui
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/webui:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/ueransim
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/ueransim:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/mongodb
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/mongodb:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/curl
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/curl:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/busybox
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/busybox:1.0.1
    - image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/sctp-test
      context: ${COMMON_CODE_ROOT:-/workdir/common}/generic
      docker:
        dockerfile: Dockerfile
        network: ${CP_NETWORK:-lab}
        buildArgs:
          BASE_IMAGE: ${REGISTRY_LAB_NAME:-registry-lab}:${REGISTRY_LAB_PORT:-5000}/sctp-test:1.0.1

deploy:
  statusCheck: true
  statusCheckDeadlineSeconds: 600
  helm:
    flags:
      install:
        - --timeout
        - ${HELM_TIMEOUT:-20m}
      upgrade:
        - --timeout
        - ${HELM_TIMEOUT:-20m}
    releases:
      - name: csi-driver-smb
        remoteChart: csi-driver-smb
        repo: https://raw.githubusercontent.com/kubernetes-csi/csi-driver-smb/master/charts
        namespace: kube-system
        wait: true

      - name: free5gc-helm
        chartPath: helm-charts/free5gc
        namespace: free5gc
        createNamespace: true
        wait: true
        skipBuildDependencies: true
        dependsOn:
          - csi-driver-smb
        setValues:
          global.imageRegistry: ""
          global.userPlaneArchitecture: single
          global.sbi.scheme: https
          global.oauth.enabled: true
          global.oauth.samba.enabled: true
          global.oauth.samba.username: k8s
          global.oauth.samba.password: password
          # MongoDB credentials are stored in Kubernetes Secrets and injected into NFs at runtime.
          global.mongodb.auth.rootSecretName: ${MONGODB_ROOT_SECRET_NAME:-free5gc-mongodb-root}
          global.mongodb.auth.appSecretName: ${MONGODB_APP_SECRET_NAME:-free5gc-mongodb-app}
          global.mongodb.auth.existingSecret: ${MONGODB_AUTH_SECRET_NAME:-free5gc-mongodb-auth}
          global.mongodb.auth.username: ${MONGODB_APP_USER:-free5gc}
          global.mongodb.auth.database: ${MONGODB_APP_DATABASE:-free5gc}
          global.mongodb.auth.authSource: ${MONGODB_AUTHSOURCE:-free5gc}
          imageUpdater.enabled: ${IMAGE_UPDATER_ENABLED:-true}
          imageUpdater.namespace: ${IMAGE_UPDATER_NAMESPACE:-kube-system}
          imageUpdater.image.repository: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/controller
          imageUpdater.image.tag: "${IMAGE_VERSION:-2.0.2}"
          imageUpdater.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          imageUpdater.registryUsername: ${REGISTRY_USER:-imageuser}
          imageUpdater.registryPassword: "${REGISTRY_PASS:-SuperPassW1!}"
          imageUpdater.runEvery: "${IMAGE_UPDATER_RUN_EVERY:-1m}"
          imageUpdater.hostNetwork: true
          imageUpdater.apiBeaconHost: "${CONTROL_PLANE_IP:-kind-control-plane}"
          imageUpdater.apiBeaconPort: "${CONTROL_PLANE_PORT:-6443}"
          free5gc-amf.amf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/amf
          free5gc-amf.amf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-amf.initcontainers.curl.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          free5gc-amf.initcontainers.curl.image: curl
          free5gc-amf.initcontainers.curl.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-ausf.ausf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/ausf
          free5gc-ausf.ausf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-ausf.initcontainers.curl.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          free5gc-ausf.initcontainers.curl.image: curl
          free5gc-ausf.initcontainers.curl.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-chf.chf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/chf
          free5gc-chf.chf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-chf.initcontainers.curl.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          free5gc-chf.initcontainers.curl.image: curl
          free5gc-chf.initcontainers.curl.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-n3iwf.n3iwf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/n3iwf
          free5gc-n3iwf.n3iwf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-nef.nef.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/nef
          free5gc-nef.nef.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-nef.initcontainers.curl.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          free5gc-nef.initcontainers.curl.image: curl
          free5gc-nef.initcontainers.curl.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-nrf.nrf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/nrf
          free5gc-nrf.nrf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-nssf.nssf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/nssf
          free5gc-nssf.nssf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-nwdaf.nwdaf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/nwdaf
          free5gc-nwdaf.nwdaf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          mongodbNwdaf.image.repository: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/mongodb
          mongodbNwdaf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-nwdaf.nwdaf.extraEnv[0].name: GROUP
          free5gc-nwdaf.nwdaf.extraEnv[0].value: cluster
          free5gc-nwdaf.nwdaf.extraEnv[1].name: CALDERA_URL
          free5gc-nwdaf.nwdaf.extraEnv[1].value: "${CALDERA_URL:-http://caldera:8888}"
          free5gc-nwdaf.nwdaf.extraEnv[2].name: LOG_NS
          free5gc-nwdaf.nwdaf.extraEnv[2].value: "${MEM_NAMESPACE:-mem}"
          free5gc-nwdaf.nwdaf.extraEnv[3].name: ATTACKED_NS
          free5gc-nwdaf.nwdaf.extraEnv[3].value: "${DMZ_NAMESPACE:-dmz}"
          free5gc-nwdaf.nwdaf.extraEnv[4].name: AUTH_NS
          free5gc-nwdaf.nwdaf.extraEnv[4].value: "${APP_NAMESPACE:-app}"
          free5gc-nwdaf.nwdaf.extraEnv[5].name: ATTACKERADDR
          free5gc-nwdaf.nwdaf.extraEnv[5].value: "${ATTACKER:-attacker}"
          free5gc-nwdaf.nwdaf.extraEnv[6].name: WAIT
          free5gc-nwdaf.nwdaf.extraEnv[6].value: "0"
          free5gc-nwdaf.nwdaf.extraEnv[7].name: ATTACKER_EXECUTION_SCRIPT
          free5gc-nwdaf.nwdaf.extraEnv[7].value: /opt/attacker-lib/nwdaf/nwdaf_server.py
          # The test NWDAF registers itself in NRF and can be exercised with the Helm test Job.
          free5gc-nwdaf.nwdaf.registration.enabled: ${NWDAF_REGISTER_ON_START:-true}
          free5gc-nwdaf.nwdaf.registrationTest.enabled: ${NWDAF_REGISTRATION_TEST_ENABLED:-true}
          free5gc-nwdaf.nwdaf.registrationTest.sequence: ${NWDAF_REGISTRATION_TEST_SEQUENCE:-SMF\,AMF\,UDM\,PCF}
          free5gc-nssf.initcontainers.curl.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          free5gc-nssf.initcontainers.curl.image: curl
          free5gc-nssf.initcontainers.curl.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-pcf.pcf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/pcf
          free5gc-pcf.pcf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-pcf.pcf.hostNetwork: "${PCF_HOST_NETWORK:-true}"
          free5gc-pcf.pcf.dnsPolicy: ClusterFirstWithHostNet
          free5gc-pcf.pcf.serviceAccountName: nfs
          free5gc-pcf.pcf.automountServiceAccountToken: true
          free5gc-pcf.pcf.podSecurityContext.runAsUser: 0
          free5gc-pcf.pcf.podSecurityContext.runAsGroup: 0
          free5gc-pcf.pcf.podSecurityContext.runAsNonRoot: false
          free5gc-pcf.pcf.podSecurityContext.fsGroup: 0
          free5gc-pcf.pcf.securityContext.allowPrivilegeEscalation: true
          free5gc-pcf.pcf.extraPorts[0].name: pcf-test
          free5gc-pcf.pcf.extraPorts[0].containerPort: ${PCF_TEST_SERVICE_PORT:-2525}
          free5gc-pcf.pcf.extraPorts[0].protocol: TCP
          free5gc-pcf.pcf.extraEnv[0].name: RCE_ENABLED
          free5gc-pcf.pcf.extraEnv[0].value: "${RCE_VULN:-true}"
          free5gc-pcf.pcf.extraEnv[1].name: SERVICE_PROTOCOL_NAME
          free5gc-pcf.pcf.extraEnv[1].value: pcf-test-service
          free5gc-pcf.pcf.extraEnv[2].name: APP_METRIC_PREFIX
          free5gc-pcf.pcf.extraEnv[2].value: pcf_test_service
          free5gc-pcf.pcf.extraEnv[3].name: TEST_SERVICE_LISTEN_PORT
          free5gc-pcf.pcf.extraEnv[3].value: "${PCF_TEST_SERVICE_PORT:-2525}"
          free5gc-pcf.pcf.extraEnv[4].name: SERVICE_BANNER
          free5gc-pcf.pcf.extraEnv[4].value: "220 PCF Test Service Ready"
          free5gc-pcf.pcf.extraEnv[5].name: ATTACKERADDR
          free5gc-pcf.pcf.extraEnv[5].value: "${ATTACKER:-attacker}"
          free5gc-pcf.initcontainers.curl.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          free5gc-pcf.initcontainers.curl.image: curl
          free5gc-pcf.initcontainers.curl.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-smf.smf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/smf
          free5gc-smf.smf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-smf.initcontainers.curl.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          free5gc-smf.initcontainers.curl.image: curl
          free5gc-smf.initcontainers.curl.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-udm.udm.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/udm
          free5gc-udm.udm.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-udm.initcontainers.curl.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          free5gc-udm.initcontainers.curl.image: curl
          free5gc-udm.initcontainers.curl.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-udr.udr.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/udr
          free5gc-udr.udr.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-udr.initcontainers.curl.registry: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}
          free5gc-udr.initcontainers.curl.image: curl
          free5gc-udr.initcontainers.curl.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-webui.webui.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/webui
          free5gc-webui.webui.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-dbpython.dbpython.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/dbpython
          free5gc-dbpython.dbpython.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-nrf.initcontainers.busybox.image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/busybox
          free5gc-nrf.initcontainers.busybox.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-webui.initcontainers.busybox.image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/busybox
          free5gc-webui.initcontainers.busybox.tag: "${IMAGE_VERSION:-2.0.2}"
          mongodb.image.registry: ""
          mongodb.image.repository: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/mongodb
          mongodb.image.tag: "${IMAGE_VERSION:-2.0.2}"
          # Bitnami MongoDB reads these existing Secret keys: mongodb-root-password and mongodb-passwords.
          mongodb.auth.enabled: true
          mongodb.auth.existingSecret: ${MONGODB_AUTH_SECRET_NAME:-free5gc-mongodb-auth}
          mongodb.auth.usernames[0]: ${MONGODB_APP_USER:-free5gc}
          mongodb.auth.databases[0]: ${MONGODB_APP_DATABASE:-free5gc}
          free5gc-upf.upf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/upf
          free5gc-upf.upf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-upf.iupf.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/upf
          free5gc-upf.iupf.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-upf.psaupf1.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/upf
          free5gc-upf.psaupf1.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-upf.psaupf2.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/upf
          free5gc-upf.psaupf2.image.tag: "${IMAGE_VERSION:-2.0.2}"
          free5gc-upf.upf.readinessProbe.enabled: false
          free5gc-upf.upf.livenessProbe.enabled: false
          free5gc-upf.upf.configmap.wrapperAdditionalCommands: |-
            if [ ! -d /sys/module/gtp5g ] && [ ! -d /sys/module/gtp ]; then
              echo "[wrapper] gtp5g kernel module unavailable; keeping UPF pod alive for Kind startup"
              sleep infinity
            fi

      - name: ueransim
        chartPath: helm-charts/ueransim-gnb
        namespace: free5gc
        createNamespace: true
        wait: true
        skipBuildDependencies: true
        dependsOn:
          - free5gc-helm
        setValues:
          global.free5gcReleaseName: free5gc-helm
          gnb.enabled: true
          gnb.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/ueransim
          gnb.image.tag: "${IMAGE_VERSION:-2.0.2}"
          initcontainers.sctp_test.image: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/sctp-test
          initcontainers.sctp_test.tag: "${IMAGE_VERSION:-2.0.2}"
          ue.enabled: true
          ue.image.name: ${REGISTRY_NAME:-registry}:${REGISTRY_PORT:-5000}/ueransim
          ue.image.tag: "${IMAGE_VERSION:-2.0.2}"

profiles:
  - name: with-cilium
    activation:
      - env: CILIUM_ENABLED=true
    patches:
      - op: add
        path: /deploy/helm/releases/0
        value:
          name: cilium
          remoteChart: cilium
          repo: https://helm.cilium.io/
          namespace: kube-system
          wait: true
          setValues:
            "operator.replicas": 1
            "sctp.enabled": true
