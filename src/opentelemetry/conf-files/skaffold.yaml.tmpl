      - env: CILIUM_ENABLED=true
    patches:
      - op: add
        path: /deploy/helm/releases/0
        value:
          name: cilium
          remoteChart: cilium
          repo: https://helm.cilium.io/
          namespace: kube-system
          wait: true
          setValues:
            "operator.replicas": 1
