profiles:
  - name: without-samba
    activation:
      - env: SAMBA_ENABLE=false
    patches:
      - op: remove
        path: /deploy/helm/releases/1

  - name: with-cilium
    activation:
      - env: CILIUM_ENABLED=true
    patches:
      - op: add
        path: /deploy/helm/releases/0
        value:
          name: cilium
          remoteChart: cilium
          repo: https://helm.cilium.io/
          namespace: kube-system
          wait: true
          setValues:
            "operator.replicas": 1
